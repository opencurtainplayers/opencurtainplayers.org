---
import { ticketEmbedUrl } from "../lib/tickets.mjs";
---

<section class="ticket-panel" aria-labelledby="booking-heading">
  <div class="ticket-panel-header">
    <div>
      <p class="eyebrow">Box office</p>
      <h2 id="booking-heading">Choose your event</h2>
    </div>
  </div>
  <p id="ticket-help">
    If the booking panel does not load or is difficult to use,{" "}
    <a href="/contact/">contact our team for assistance</a>.
  </p>
  <iframe
    id="ludusWidget"
    title="Open Curtain Players event booking"
    aria-describedby="ticket-help"
    src={ticketEmbedUrl}
    width="100%"
    height="650"
    loading="eager"
    sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-modals allow-forms allow-top-navigation-by-user-activation allow-popups allow-popups-to-escape-sandbox"
  ></iframe>
</section>

<script>
  import { getTicketHeight, isTicketMessage } from "../lib/tickets.mjs";

  const frame = document.querySelector<HTMLIFrameElement>("#ludusWidget");
  if (frame) {
    window.addEventListener("message", (event) => {
      if (!isTicketMessage(event, frame.contentWindow)) return;
      const height = getTicketHeight(event.data);
      if (height !== null) frame.style.height = `${height}px`;
      if (
        typeof event.data === "string" &&
        event.data.startsWith("windowResize::")
      ) {
        frame.style.height = `${Math.max(350, window.innerHeight)}px`;
      }
      if (typeof event.data === "string" && event.data.startsWith("scroll::")) {
        frame.scrollIntoView({ block: "start" });
      }
    });
  }
</script>
