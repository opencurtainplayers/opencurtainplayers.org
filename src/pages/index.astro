---
import SiteLayout from "../layouts/SiteLayout.astro";
import { organization, production } from "../data/site";
---

<SiteLayout
  title="Theater for every kind of mind"
  description="Discover inclusive, sensory-friendly theater in Valrico, Florida. Explore our mission, programs, upcoming production, and Ludus tickets."
>
  <section class="hero" aria-labelledby="home-heading">
    <div class="hero-inner container">
      <div class="hero-copy">
        <p class="eyebrow">
          Valrico, Florida &middot; Theater for all abilities
        </p>
        <h1 id="home-heading">
          The curtain opens.
          <br />
          <em>Everyone belongs.</em>
        </h1>
        <p class="lead">
          Sensory-friendly, judgment-free theater that brings performers,
          audiences, and families together.
        </p>
        <div class="actions">
          <a class="button" href="/tickets/">
            Explore performances
          </a>
          <a class="text-link" href="/mission/">
            Meet our mission <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
      <div class="stage-art" aria-hidden="true">
        <div class="stage-arch"></div>
        <p>
          A little wonder.
          <br />A lot of belonging.
        </p>
        <span class="stage-caption">Open Curtain Players / Est. 2026</span>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="welcome-heading">
    <div class="section-split">
      <div>
        <p class="eyebrow">A different kind of theater</p>
        <h2 id="welcome-heading">
          Make yourself
          <br />
          at home.
        </h2>
      </div>
      <div class="prose">
        <p class="lead">{organization.mission}</p>
        <p>
          Based in Valrico, our nonprofit connects people through the performing
          arts across Brandon, Valrico, and Lithia.
        </p>
        <a class="text-link" href="/programs/">
          Discover our programs & projects
        </a>
      </div>
    </div>
  </section>

  <section class="production-band" aria-labelledby="production-heading">
    <div class="container section-split">
      <div>
        <p class="eyebrow">Coming to the stage</p>
        <h2 id="production-heading">{production.title}</h2>
      </div>
      <div class="prose">
        <p class="date-line">
          Opening <time datetime={production.dateTime}>{production.opens}</time>
        </p>
        <p>
          Join us for our upcoming production. Find available performances,
          venue information, and booking details through Ludus.
        </p>
        <a class="button" href="/tickets/">
          View tickets & details
        </a>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="explore-heading">
    <p class="eyebrow">Get to know us</p>
    <h2 id="explore-heading">More than a moment on stage.</h2>
    <div class="card-grid">
      <article class="card">
        <span class="card-number" aria-hidden="true">
          01
        </span>
        <h3>Our purpose</h3>
        <p>
          Breaking down barriers so people of all abilities can connect and
          shine.
        </p>
        <a href="/mission/">Read our mission</a>
      </article>
      <article class="card">
        <span class="card-number" aria-hidden="true">
          02
        </span>
        <h3>Our beginnings</h3>
        <p>A new Florida theater organization, founded on March 31, 2026.</p>
        <a href="/history/">Explore our history</a>
      </article>
      <article class="card">
        <span class="card-number" aria-hidden="true">
          03
        </span>
        <h3>Our community</h3>
        <p>
          Volunteer, explore a partnership, or ask about supporting our work.
        </p>
        <a href="/contact/">Contact our team</a>
      </article>
    </div>
  </section>
</SiteLayout>
