---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import LudusTickets from "../components/LudusTickets.astro";
import { production } from "../data/site";
---

<SiteLayout
  title="Tickets"
  description="Browse Open Curtain Players events and book tickets here. A Christmas Carol Story opens December 18, 2026."
>
  <PageIntro
    eyebrow="Your next theater experience"
    title="A seat for the magic."
    summary={`${production.title} opens ${production.opens}. Browse all available events and book below.`}
  />
  <div class="section container">
    <div class="notice">
      <p>
        <strong>Planning your visit?</strong>{" "}
        <a href="/contact/">Ask us about access and sensory accommodations</a>{" "}
        before booking.
      </p>
    </div>
    <LudusTickets />
  </div>
</SiteLayout>
